{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexDesk",
  "identifier": "com.oosthash.hexdesk",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "pnpm dev"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "pnpm build"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HexDesk",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#161b22"
      },
      {
        "label": "relic-overlay",
        "url": "index.html?overlay",
        "title": "HexDesk Overlay",
        "width": 1920,
        "height": 400,
        "x": 0,
        "y": -3000,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "relic-pick-overlay",
        "url": "index.html#relicpickoverlay",
        "title": "HexDesk Relic Picker",
        "width": 340,
        "height": 80,
        "x": 0,
        "y": -3000,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "overlay-status",
        "url": "index.html#overlaystatus",
        "title": "HexDesk Overlay Status",
        "width": 440,
        "height": 52,
        "x": 0,
        "y": -3000,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "riven-overlay",
        "url": "index.html#rivenoverlay",
        "title": "HexDesk Riven",
        "width": 300,
        "height": 600,
        "x": 0,
        "y": -3000,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNUYyMEVGQjM5QzkyREIKUldUYmtweXo3eUJmai9rdk9YQmtvS3BMUmh2a0hDU0lWVWFTOGIxNmlUU0VVNjVTR2RkTndENnQK",
      "endpoints": [
        "https://github.com/OostHash/HexDesk/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "OostHash",
    "homepage": "https://github.com/OostHash/HexDesk",
    "license": "GPL-3.0-only",
    "category": "Utility",
    "shortDescription": "A free, open-source desktop companion for Warframe.",
    "longDescription": "The Origin System, connected: inventory, market, trading, timer, relic, and riven tools for Warframe.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
